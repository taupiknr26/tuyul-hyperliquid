# hlbot settings. Copy to .env and edit. This file holds NO secrets:
# the Telegram API hash and bot token go in the owner-only file named by
# SECRETS_FILE, and the Hyperliquid agent key goes alone in the
# owner-only file named by HL_AGENT_KEY_FILE. The bot refuses to start if
# either file is readable by group or others, or if a secret is put here.
#
#   botctl init-secrets ~/.config/hlbot/hlbot.secrets
#   botctl config            # shows the resolved settings, secrets hidden

# ---------------------------------------------------------------- mode
# paper    simulated fills against live MAINNET market data; every check
#          runs; no signing key is ever loaded. This is the default.
# testnet  real API, mock funds.
# mainnet  REAL FUNDS. Needs all three: HL_ENV=mainnet, the --mainnet
#          flag on `botctl start`, and HL_MAINNET_CONFIRM equal to
#          HL_ACCOUNT_ADDRESS. Missing any one of them runs PAPER and
#          says so.
HL_ENV=paper
# HL_ACCOUNT_ADDRESS=0xYOUR_ACCOUNT_ADDRESS
# HL_MAINNET_CONFIRM=
# Path to a file containing ONLY the agent (API wallet) private key,
# chmod 600. Never the master key. Use a different key for testnet and
# mainnet, and never reuse an agent address after it expires.
# HL_AGENT_KEY_FILE=~/.config/hlbot/agent-testnet.key
# Only when trading a sub-account:
# HL_VAULT_ADDRESS=

# Signal symbol -> Hyperliquid coin. Asset ids are resolved at runtime.
HL_SYMBOL_MAP={"GOLD": "xyz:GOLD"}
# HL_SYMBOL_MAP={"GOLD": "xyz:GOLD", "XAUUSD": "xyz:GOLD"}
HL_MARGIN_MODE=cross
# Take-profit style: limit (resting reduce-only limit) | trigger (mark-triggered market)
HL_TP_STYLE=limit
# Fee rate used in sizing is never below this (2x base taker; see IV-11).
HL_FEE_RATE_FALLBACK=0.0009
# Paper mode starting equity in USDC. Note RISK_MAX_TRADE_NOTIONAL: with
# the default 0.5 % risk and a 12-point stop, an account above roughly
# 2,400 USDC sizes trades over the 5,000 USDC cap and they are REJECTED
# (size is never reduced to fit). Raise the cap or lower the risk.
PAPER_START_EQUITY=1000

# ---------------------------------------------------------------- secrets
SECRETS_FILE=~/.config/hlbot/hlbot.secrets

# ---------------------------------------------------------------- telegram
TELEGRAM_ENABLED=true
TELEGRAM_API_ID=123456
# Session file: a full-account credential. Keep it outside the repository.
TELEGRAM_SESSION=~/.config/hlbot/telegram.session
# @username, invite link, or numeric id; comma-separated for several.
TELEGRAM_CHANNEL=@channel_name
# Channel -> parser format (default | entry_limit). Unlisted channels use "default".
# TELEGRAM_CHANNEL_PARSERS={"-1001234567890": "entry_limit"}
TELEGRAM_BACKFILL_LIMIT=50

# Notifications through a separate bot (token in the secrets file).
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_NOTIFY_CHAT_ID=

# ---------------------------------------------------------------- entry
# The zone is widened by this many price points on each side.
EXEC_BUFFER_ENABLED=true
EXEC_BUFFER_VALUE=2.0
EXEC_SIGNAL_EXPIRY_MINUTES=30
# Share of the position closed at TP1, TP2, ... (must add up to 100).
EXEC_TP_CLOSE_PERCENTS=20,20,20,20,20
EXEC_TP_BUFFER_VALUE=0
# Entry is a limit IOC at the touch -/+ this many points, clamped so a
# fill can never land beyond TP1 (EXEC_MIN_TP_GAP_POINTS short of it).
EXEC_MAX_SLIPPAGE_POINTS=3.0
EXEC_MIN_TP_GAP_POINTS=0.5
EXEC_ENTRY_ATTEMPTS=3
EXEC_ENTRY_TTL_MS=5000
EXEC_DUPLICATE_PROTECTION=true
EXEC_MAX_QUOTE_AGE_MS=2000
EXEC_MAX_ACCOUNT_AGE_MS=5000
# Shift every signal level by a fixed offset (signal feed vs this market).
EXEC_PRICE_OFFSET_POINTS=0
# accept: re-plan SL and TPs on the filled size | flatten: close it
EXEC_PARTIAL_FILL_POLICY=accept

# ---------------------------------------------------------------- protection
# Not verified on the exchange by SOFT: SL re-placed once. By HARD: flatten.
EXEC_PROTECT_SOFT_MS=3000
EXEC_PROTECT_HARD_MS=8000
EXEC_FLATTEN_SLIPPAGE_PCT=1
EXEC_FLATTEN_MAX_SLIPPAGE_PCT=5
EXEC_FLATTEN_DEADLINE_MS=15000
EXEC_SL_RESIZE_ON_TP=true
EXEC_SL_BREAKEVEN_AFTER_TP1=false
EXEC_WS_STALE_MS=10000
# Reconciliation cadence in seconds.
AUTO_POLL_INTERVAL=15

# ---------------------------------------------------------------- risk (all ON by default)
RISK_SIZING_MODE=risk
RISK_PER_TRADE_PCT=0.5
# RISK_FIXED_SIZE=
RISK_COMPOUND_ENABLED=true
# RISK_FIXED_EQUITY_BASELINE=
RISK_MAX_DAILY_LOSS_PCT=2.0
# RISK_DAILY_TARGET_PCT=
RISK_MAX_OPEN_TRADES=3
RISK_MAX_EXPOSURE_X_EQUITY=3.0
RISK_LEVERAGE=5
RISK_MIN_RR=0.5
RISK_SL_SLIPPAGE_ALLOWANCE_POINTS=1.0
RISK_MAX_SL_DISTANCE=30.0
RISK_MARGIN_USAGE_CAP=0.5
RISK_LIQ_BUFFER_X=1.5
RISK_MAX_TRADE_NOTIONAL=5000
# RISK_MAX_MARK_ORACLE_DEV_POINTS=
RISK_LIQ_ALERT_FRACTION=0.25

# ---------------------------------------------------------------- runtime
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO
API_ENABLED=true
# Keep on loopback. Remote access: SSH tunnel or an authenticating reverse proxy.
API_HOST=127.0.0.1
API_PORT=8787
# Only when the dashboard is published through a reverse proxy or tunnel
# (Cloudflare Tunnel, nginx, ...): the public address(es) people open it
# at, comma-separated, scheme and host only. Without it, signing in from
# that address is refused. The bot itself stays on loopback.
# API_PUBLIC_ORIGINS=https://dashboard.example.com

# ---------------------------------------------------------------- scenario outlook (dashboard only)
# A level-based brief per session on the dashboard: context, key levels
# and if/then scenarios with an invalidation. A scenario outlook, not
# news and not a signal: it sends no order and the trading engine never
# reads it. See README "Scenario outlook" and docs/outlook.md.
OUTLOOK_ENABLED=true
# The managed coin whose live price and candles the outlook uses. Default:
# the coin in HL_SYMBOL_MAP that ends in GOLD; none there, the outlook is off.
# OUTLOOK_COIN=xyz:GOLD
# OUTLOOK_INSTRUMENT=XAUUSD
# Brief time and approximate session open, in the outlook's own zone.
# Briefs run Monday to Friday; each is valid until the next one. London
# and New York move with daylight saving: adjust these twice a year.
# OUTLOOK_SESSIONS={"asia": ["06:45", "07:00"], "london": ["13:45", "14:00"], "newyork": ["20:15", "20:30"]}
OUTLOOK_TZ_NAME=WIB
OUTLOOK_TZ_OFFSET_MINUTES=420
# Levels from different sources within this distance are one level (a
# confluence when two or more sources agree).
OUTLOOK_CONFLUENCE_TOLERANCE=5
# A user's own level further than this from price is archived at the next brief.
OUTLOOK_CARRY_DISTANCE=50
# Fewer level sources than this answered: the brief is marked "low confidence".
OUTLOOK_MIN_LEVEL_SOURCES=2
# Days of past briefs kept for the outcome review (0 keeps them all).
OUTLOOK_HISTORY_DAYS=365
# Default no-trade window around a high-impact release, in minutes
# (each viewer can change theirs on the page).
OUTLOOK_NO_TRADE_BEFORE_MIN=15
OUTLOOK_NO_TRADE_AFTER_MIN=15
# A high-impact release makes the running brief stale; the refreshed one
# follows this many minutes later.
OUTLOOK_EVENT_REFRESH_DELAY_MIN=5
# Seconds between two uses of the "Refresh outlook" button.
OUTLOOK_REFRESH_COOLDOWN_S=300
# Sources. Built in and on: hl-pivots, hl-ranges, hl-swings, hl-averages
# (computed from Hyperliquid candles), bls-calendar, fed-calendar
# (official, public domain). Built in but OFF until you have checked
# their terms of use: ff-calendar, investing-commodities.
# OUTLOOK_SOURCES_ENABLE=ff-calendar,investing-commodities
# OUTLOOK_SOURCES_DISABLE=hl-averages
# A JSON list that changes a built-in source (same id) or adds one:
#   [{"id": "desk-levels", "kind": "levels_json", "url": "https://example.com/levels.json", "weight": 2, "offset": 0}]
# OUTLOOK_SOURCES_FILE=~/.config/hlbot/outlook-sources.json
